# ios/fastlane/Fastfile
# Fastlane automation for Shuddhaahar iOS builds
# Handles: signing, building, versioning, upload to TestFlight / App Store

default_platform(:ios)

APP_IDENTIFIER_STAGING    = "com.shuddhaahar.staging"
APP_IDENTIFIER_PRODUCTION = "com.shuddhaahar"
TEAM_ID                   = ENV["APPLE_TEAM_ID"] || "YOUR_TEAM_ID"
WORKSPACE                 = "Shuddhaahar.xcworkspace"

# ─── Shared: Load App Store Connect API key ───────────────────
def asc_api_key
  app_store_connect_api_key(
    key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id:     ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content:   Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_BASE64"]),
    in_house:      false,
  )
end

platform :ios do

  # ── Before all: ensure clean state ──────────────────────────
  before_all do
    ensure_git_status_clean(
      show_uncommitted_changes: true,
      show_diff: true,
    ) if ENV["CI"]
  end

  # ════════════════════════════════════════════════════════════
  # STAGING LANE → TestFlight (internal testers)
  # Triggered by push to staging branch
  # ════════════════════════════════════════════════════════════
  lane :staging do
    UI.message "🚀 Building Shuddh Aahar Staging for TestFlight..."

    update_google_signin_url_scheme
    api_key = asc_api_key

    # Bump build number using latest TestFlight build + 1
    latest_build = latest_testflight_build_number(
      api_key:       api_key,
      app_identifier: APP_IDENTIFIER_STAGING,
    )
    increment_build_number(build_number: latest_build + 1)

    # Download provisioning profile from App Store Connect
    get_provisioning_profile(
      api_key:          api_key,
      app_identifier:   APP_IDENTIFIER_STAGING,
      provisioning_name: "Shuddhaahar Staging Distribution",
      output_path:      "../build",
      force:            false,
    )

    # Build the app
    build_app(
      workspace:          WORKSPACE,
      scheme:             "ShuddhaaharStaging",
      configuration:      "Release",
      export_method:      "app-store",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER_STAGING => "Shuddhaahar Staging Distribution",
        }
      },
      output_directory:   "../build",
      output_name:        "Shuddhaahar-Staging.ipa",
      include_symbols:    true,
      include_bitcode:    false,
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key:            api_key,
      app_identifier:     APP_IDENTIFIER_STAGING,
      ipa:                "../build/Shuddhaahar-Staging.ipa",
      skip_waiting_for_build_processing: false,
      notify_external_testers: false,  # only internal testers for staging
      changelog:          git_commit_message,
    )

    # Notify Slack
    slack(
      message:     "✅ Shuddh Aahar Staging #{get_version_number} (#{get_build_number}) uploaded to TestFlight",
      channel:     "#releases",
      webhook_url:  ENV["SLACK_WEBHOOK_URL"],
    ) if ENV["SLACK_WEBHOOK_URL"]

    UI.success "Staging build uploaded to TestFlight ✓"
  end

  # ════════════════════════════════════════════════════════════
  # PRODUCTION LANE → App Store submission
  # Triggered by push to main branch (after manual approval)
  # ════════════════════════════════════════════════════════════
  lane :production do
    UI.message "🍎 Building Shuddh Aahar for App Store submission..."

    update_google_signin_url_scheme
    api_key = asc_api_key

    # Bump build number
    latest_build = latest_testflight_build_number(
      api_key:        api_key,
      app_identifier: APP_IDENTIFIER_PRODUCTION,
    )
    increment_build_number(build_number: latest_build + 1)

    # Download provisioning profile
    get_provisioning_profile(
      api_key:           api_key,
      app_identifier:    APP_IDENTIFIER_PRODUCTION,
      provisioning_name: "Shuddhaahar AppStore Distribution",
      output_path:       "../build",
    )

    # Build the app
    build_app(
      workspace:         WORKSPACE,
      scheme:            "ShuddhaaharProduction",
      configuration:     "Release",
      export_method:     "app-store",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER_PRODUCTION => "Shuddhaahar AppStore Distribution",
        }
      },
      output_directory:  "../build",
      output_name:       "Shuddhaahar.ipa",
      include_symbols:   true,
      include_bitcode:   false,
    )

    # Upload to App Store (as draft — requires manual submission in App Store Connect)
    deliver(
      api_key:            api_key,
      app_identifier:     APP_IDENTIFIER_PRODUCTION,
      ipa:                "../build/Shuddhaahar.ipa",
      submit_for_review:  false,  # manual review submission
      automatic_release:  false,  # manual release
      force:              true,
      metadata_path:      "./metadata",
      screenshots_path:   "./screenshots",
      skip_metadata:      false,
      skip_screenshots:   false,
    )

    # Tag the release in git
    version = get_version_number
    build   = get_build_number
    add_git_tag(tag: "v#{version}-#{build}-production")
    push_git_tags

    # Notify Slack
    slack(
      message:     "🎉 Shuddh Aahar #{version} (#{build}) submitted to App Store for review!",
      channel:     "#releases",
      webhook_url:  ENV["SLACK_WEBHOOK_URL"],
    ) if ENV["SLACK_WEBHOOK_URL"]

    UI.success "Production build submitted to App Store ✓"
  end

  # ── Local dev helpers ────────────────────────────────────────
  lane :screenshots do
    capture_screenshots(workspace: WORKSPACE, scheme: "ShuddhaaharUITests")
    frame_screenshots(white: true)
  end

  lane :tests do
    run_tests(workspace: WORKSPACE, scheme: "ShuddhaaharTests", devices: ["iPhone 16 Pro"])
  end

  # ── After all: clean up keychain ────────────────────────────
  after_all do |lane|
    UI.success "Lane '#{lane}' completed successfully"
  end

  error do |lane, exception|
    UI.error "Lane '#{lane}' failed: #{exception.message}"
    slack(
      message:     "❌ Shuddh Aahar #{lane} build FAILED: #{exception.message}",
      channel:     "#releases",
      webhook_url:  ENV["SLACK_WEBHOOK_URL"],
      success:     false,
    ) if ENV["SLACK_WEBHOOK_URL"]
  end

end

# ── Helper ───────────────────────────────────────────────────
def git_commit_message
  sh("git log -1 --pretty=%B").strip
rescue
  "Automated build"
end

# Info.plist's GoogleSignIn CFBundleURLTypes entry is checked in pointing at
# the dev OAuth client's reversed ID (see the comment in Info.plist) because
# that one file is shared by all three Xcode schemes — only one environment's
# Google Sign-In redirect can be correct in the committed file at a time.
# Every staging/production build must patch it to the client ID for the
# environment actually being built, or Google Sign-In silently fails to
# redirect back into the app post-login. ci.yml sets GOOGLE_IOS_CLIENT_ID to
# the right per-environment secret before invoking each lane.
def update_google_signin_url_scheme
  client_id = ENV["GOOGLE_IOS_CLIENT_ID"]
  UI.user_error!("GOOGLE_IOS_CLIENT_ID is not set — this build's Google Sign-In would be broken") if client_id.to_s.empty?

  id_prefix = client_id.sub(/\.apps\.googleusercontent\.com\z/, "")
  reversed_scheme = "com.googleusercontent.apps.#{id_prefix}"

  update_info_plist(
    plist_path: "Shuddhaahar/Info.plist",
    block: proc do |plist|
      google_entry = plist["CFBundleURLTypes"].find { |t| t["CFBundleURLName"] == "GoogleSignIn" }
      UI.user_error!("No GoogleSignIn entry found in Info.plist's CFBundleURLTypes") unless google_entry
      google_entry["CFBundleURLSchemes"] = [reversed_scheme]
    end
  )
  UI.success "Patched Info.plist GoogleSignIn URL scheme → #{reversed_scheme}"
end
