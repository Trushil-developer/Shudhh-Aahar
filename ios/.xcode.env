export NODE_BINARY=$(command -v node)

# babel.config.js picks which .env.<env> file to inline from SHUDDHAAHAR_ENV,
# and falls back to development when it's unset. scripts/build.sh exports it,
# but an archive made straight from Xcode (Product > Archive) never runs that
# script, which once shipped an App Store build on DEV_CONFIG (no Apple
# sign-in URL, admin panel enabled). Release builds default to production;
# an explicitly exported value (e.g. staging via build.sh) still wins.
if [ "$CONFIGURATION" = "Release" ] && [ -z "$SHUDDHAAHAR_ENV" ]; then
  export SHUDDHAAHAR_ENV=production
fi
