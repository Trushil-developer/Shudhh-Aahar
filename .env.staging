# .env.staging
# Staging environment — TestFlight / internal testing builds
# Copy to .env.staging.local with real values

SHUDDHAAHAR_ENV=staging

# AWS AppSync + Google Sign-In (staging — separate stack from prod)
STAGING_APPSYNC_ENDPOINT=https://your-staging-appsync-id.appsync-api.eu-west-2.amazonaws.com/graphql
STAGING_GOOGLE_WEB_CLIENT_ID=your_staging_web_client_id.apps.googleusercontent.com
STAGING_GOOGLE_IOS_CLIENT_ID=your_staging_ios_client_id.apps.googleusercontent.com

# Anthropic
STAGING_ANTHROPIC_API_KEY=sk-ant-staging-your-key-here

# Trolley
STAGING_TROLLEY_API_KEY=your_staging_trolley_key

# IAP receipt verification endpoint
STAGING_IAP_VERIFY_URL=

# Remote app-config endpoint (min version / kill switches / daily scan limit)
STAGING_APP_CONFIG_URL=
