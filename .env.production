# .env.production
# Production environment — App Store / Google Play live builds
# NEVER put real values in this file — use CI/CD secrets injection
# These are template placeholders only

SHUDDHAAHAR_ENV=production

# AWS AppSync + Google Sign-In (production)
PROD_APPSYNC_ENDPOINT=INJECTED_BY_CI
PROD_GOOGLE_WEB_CLIENT_ID=INJECTED_BY_CI
PROD_GOOGLE_IOS_CLIENT_ID=INJECTED_BY_CI

# Anthropic (production key — set in CI/CD secrets, not here)
PROD_ANTHROPIC_API_KEY=INJECTED_BY_CI

# Trolley
PROD_TROLLEY_API_KEY=INJECTED_BY_CI

# IAP receipt verification endpoint — not secret, environment.ts already
# falls back to the real deployed URL if this isn't set.
PROD_IAP_VERIFY_URL=INJECTED_BY_CI

# Remote app-config endpoint — not secret, environment.ts already falls
# back to the real deployed URL if this isn't set.
PROD_APP_CONFIG_URL=INJECTED_BY_CI
