# .env.development
# Development environment — local/simulator testing
# Copy this to .env.development.local and fill in your real values
# NEVER commit .env.*.local files to git

SHUDDHAAHAR_ENV=development

# AWS AppSync + Google Sign-In (dev)
DEV_APPSYNC_ENDPOINT=https://your-dev-appsync-id.appsync-api.eu-west-2.amazonaws.com/graphql
DEV_GOOGLE_WEB_CLIENT_ID=your_dev_web_client_id.apps.googleusercontent.com
DEV_GOOGLE_IOS_CLIENT_ID=your_dev_ios_client_id.apps.googleusercontent.com

# Anthropic (use a separate dev API key with usage limits)
DEV_ANTHROPIC_API_KEY=sk-ant-dev-your-key-here

# Trolley.co.uk (free dev key from dev.trolley.co.uk)
DEV_TROLLEY_API_KEY=your_dev_trolley_key

# IAP receipt verification endpoint — set to the deployed iap-verify Lambda
# URL if testing purchases against a dev backend; leave blank otherwise.
DEV_IAP_VERIFY_URL=
DEV_APPLE_AUTH_URL=

# Remote app-config endpoint (min version / kill switches / daily scan
# limit) — set to the deployed app-config API if testing against it; leave
# blank otherwise (falls back to safe defaults).
DEV_APP_CONFIG_URL=
