{
  "name": "Shuddhaahar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "SHUDDHAAHAR_ENV=development react-native start",
    "ios": "SHUDDHAAHAR_ENV=development react-native run-ios --scheme ShuddhaaharDev",
    "android": "SHUDDHAAHAR_ENV=development react-native run-android",
    "ios:staging": "SHUDDHAAHAR_ENV=staging react-native run-ios --scheme ShuddhaaharStaging",
    "android:staging": "SHUDDHAAHAR_ENV=staging react-native run-android --variant=release",
    "test": "SHUDDHAAHAR_ENV=development jest --config jest.config.json",
    "test:watch": "SHUDDHAAHAR_ENV=development jest --config jest.config.json --watch",
    "test:coverage": "SHUDDHAAHAR_ENV=development jest --config jest.config.json --coverage",
    "test:ci": "SHUDDHAAHAR_ENV=development jest --config jest.config.json --ci --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build:dev:ios": "bash scripts/build.sh dev ios",
    "build:dev:android": "bash scripts/build.sh dev android",
    "build:staging:ios": "bash scripts/build.sh staging ios",
    "build:staging:android": "bash scripts/build.sh staging android",
    "build:prod:ios": "bash scripts/build.sh prod ios",
    "build:prod:android": "bash scripts/build.sh prod android",
    "setup": "bash scripts/setup.sh dev",
    "setup:staging": "bash scripts/setup.sh staging",
    "setup:prod": "bash scripts/setup.sh prod",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "pods": "cd ios && pod install",
    "clean": "react-native clean",
    "clean:android": "cd android && ./gradlew clean",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "i18next": "^26.3.6",
    "react": "18.3.1",
    "react-i18next": "^17.0.11",
    "react-native": "0.76.0",
    "react-native-device-info": "^15.0.2",
    "react-native-document-picker": "^9.3.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.1.0",
    "react-native-iap": "^12.15.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^9.2.3",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "^3.34.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vision-camera": "^4.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/babel-preset": "^0.76.0",
    "@react-native/metro-config": "^0.76.0",
    "@react-native/typescript-config": "^0.76.0",
    "@testing-library/jest-native": "^5.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-native": "^4.1.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.0.4"
  },
  "react-native": {
    "__comment": "Screens configured in Xcode — see ios/Shuddhaahar.xcodeproj"
  }
}
