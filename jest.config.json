{
  "preset": "react-native",
  "testMatch": [
    "**/__tests__/**/*.test.ts",
    "**/__tests__/**/*.test.tsx"
  ],
  "transform": {
    "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-vision-camera|react-native-iap|react-native-health|react-native-image-picker|react-native-document-picker|react-native-fs|@react-native-async-storage|@react-native-community)/)"
  ],
  "moduleNameMapper": {
    "aws-amplify":                          "<rootDir>/__mocks__/aws-amplify.js",
    "aws-amplify/api":                      "<rootDir>/__mocks__/aws-amplify.js",
    "aws-amplify/auth":                     "<rootDir>/__mocks__/aws-amplify.js",
    "aws-amplify/utils":                    "<rootDir>/__mocks__/aws-amplify.js",
    "react-native-vision-camera":           "<rootDir>/__mocks__/react-native-vision-camera.js",
    "react-native-iap":                     "<rootDir>/__mocks__/react-native-iap.js",
    "react-native-health":                  "<rootDir>/__mocks__/react-native-health.js",
    "react-native-health-connect":          "<rootDir>/__mocks__/react-native-health.js",
    "react-native-image-picker":            "<rootDir>/__mocks__/react-native-image-picker.js",
    "react-native-document-picker":         "<rootDir>/__mocks__/react-native-document-picker.js",
    "react-native-fs":                      "<rootDir>/__mocks__/react-native-fs.js",
    "@react-native-async-storage/async-storage": "<rootDir>/__mocks__/async-storage.js",
    "@react-native-community/netinfo":      "<rootDir>/__mocks__/netinfo.js"
  },
  "setupFilesAfterFramework": [
    "@testing-library/jest-native/extend-expect"
  ],
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.d.ts",
    "!src/__tests__/**"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "testEnvironment": "node",
  "verbose": true
}
